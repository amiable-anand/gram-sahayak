{
  "name": "gram-sahayak",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for Gram Sahayak MVP",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:dev": "uvicorn app.main:app --app-dir backend --reload --host 0.0.0.0 --port 8000",
    "backend:prod": "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000",
    "search:create-index": "python scripts/create_search_index.py"
  }
}
